# Frontend (public, safe to expose). Lovable fills these when Supabase is connected.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-KEY

# Edge function secrets: set via Lovable/Supabase secrets, NEVER in this file or the repo.
# GROQ_API_KEY=...
# GROQ_WHISPER_MODEL=whisper-large-v3        (optional override)
# GROQ_LLM_MODEL=llama-3.1-8b-instant         (optional override)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
